{
  "ignorePatterns": [
    {
      "pattern": "^http(s)?://localhost"
    },
    {
      "pattern": "^http(s)?://example\\.com"
    },
    {
      "pattern": "^http(s)?://yourdomain\\.com"
    }
  ],
  "replacementPatterns": [
    {
      "pattern": "^/",
      "replacement": "https://github.com/montimage/INTACT/blob/main/"
    }
  ],
  "retry": true,
  "retryOn": [408, 429, 500, 502, 503, 504],
  "timeout": 10000,
  "getGitHubAbsolutePathPrefix": "https://raw.githubusercontent.com/montimage/INTACT/main/"
}
