# MI Digital Twin Management Platform - Environment Configuration
# Copy this file to .env and configure for your deployment

# =============================================================================
# DATABASE CONFIGURATION (choose ONE option)
# =============================================================================

# Option 1: Local MongoDB (for docker-compose.prod.yml)
# Uses the MongoDB container defined in docker-compose
MONGODB_URI=mongodb://mongodb:27017/intact

# Option 2: MongoDB Atlas (for docker-compose.atlas.yml)
# Uncomment and configure for cloud database deployment
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# MONGODB_URI=mongodb+srv://your-username:your-password@cluster0.xxxxx.mongodb.net/intact?retryWrites=true&w=majority

# =============================================================================
# SECURITY (Required - generate unique values for production)
# =============================================================================

# JWT signing secret - generate with: openssl rand -base64 48
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production

# Token expiration time
JWT_EXPIRES_IN=24h

# Credential encryption key — REQUIRED for the server to boot; there is no
# default. Generate with: openssl rand -hex 16. Any value of 16+ characters
# works (the key is SHA-256 derived before use); default/example values are
# rejected by the startup checks in every NODE_ENV.
# Never rotate after the first deploy: credentials already stored by the app
# become undecryptable.
ENCRYPTION_KEY=change-me-strong-encryption-key

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Server port (default: 3000)
PORT=3000

# Node environment
NODE_ENV=production

# CORS origin (for API access from different domain)
CORS_ORIGIN=http://localhost:3000

# =============================================================================
# SEEDING CONFIGURATION
# =============================================================================

# Automatically seed database on first container startup
# (seeding is refused when ADMIN_PASSWORD matches a known default)
SEED_ON_STARTUP=false

# Admin credentials (used during seeding) — REQUIRED for the server to boot.
# Choose a strong, unique password; known defaults (intact2025, admin,
# password) are rejected at seed time and flagged at startup.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-admin-password

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# Maestro API base URL
MAESTRO_BASE_URL=https://maestro.intact-project.eu

# =============================================================================
# BRANDING
# =============================================================================

# Branding profile: default | intact | secassured
# See docs/installation/configuration.md for per-field overrides.
BRANDING_PROFILE=secassured
