#!/bin/sh

# MI Digital Twin Management Service - Pre-commit Hook
# Runs quality checks before allowing commits

echo "Running pre-commit checks..."

# Run lint-staged for staged files (format + lint)
echo "Checking staged files..."
npx lint-staged

# Check for security vulnerabilities (warning only, doesn't block)
echo "Checking for security vulnerabilities..."
npm audit --audit-level=moderate 2>/dev/null || echo "Security scan: Some vulnerabilities found (review recommended)"

# Type checking (test files excluded — tests run via vitest)
echo "Running type checks..."
./node_modules/.bin/tsc --noEmit -p client/tsconfig.json || { echo "Client type check failed!"; exit 1; }
./node_modules/.bin/tsc --noEmit -p server/tsconfig.json || { echo "Server type check failed!"; exit 1; }

# Build client for deployment
echo "Building client for deployment..."
cd client && npm run build || { echo "Client build failed!"; exit 1; }
cd ..

# Stage the client build output (builds to server/public/)
git add server/public/

echo "All pre-commit checks passed!"
