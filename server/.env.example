# Server Configuration
NODE_ENV=development
PORT=3000

# Database - Local MongoDB
MONGODB_URI=mongodb://localhost:27017/intact

# Database - MongoDB Atlas (uncomment and configure for cloud deployment)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# MONGODB_URI=mongodb+srv://your-username:your-password@cluster0.xxxxx.mongodb.net/intact?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production
JWT_EXPIRES_IN=24h

# CORS
CORS_ORIGIN=http://localhost:5173

# Admin User (for seeding)
ADMIN_USERNAME=admin
# REQUIRED — no default. Known defaults (intact2025, admin, password) are
# refused by seeding; example values are flagged as startup errors in production.
ADMIN_PASSWORD=change-me-strong-admin-password

# Credential encryption key
# REQUIRED — no default. Minimum 16 characters; the value is SHA-256 derived
# into the AES-256 key, so any length at or above the floor works.
# Generate with: openssl rand -hex 16. Default/example values are rejected by
# the startup checks in every NODE_ENV.
# Never rotate after the first deploy: stored credentials become undecryptable.
ENCRYPTION_KEY=change-me-strong-encryption-key

# Branding profile: default | intact | secassured
BRANDING_PROFILE=secassured
