# Unified Dockerfile - Serves both API and client from single container
# Use this for simplified deployments (demos, staging, single-server hosting)
#
# Monorepo note: this is an npm workspaces repository — the ROOT
# package-lock.json is the sole dependency resolution source (the
# per-workspace lockfiles are stale leftovers). Both builder stages therefore
# install from the root lockfile with --workspace filters; server deps land in
# the hoisted /app/node_modules directory.

# Stage 1: Build client
FROM node:22-bookworm-slim AS client-builder

WORKDIR /app

# Workspace manifests must all be present for npm to resolve the workspace
# graph; only the lockfile-listed client dependencies are installed.
COPY package.json package-lock.json ./
COPY client/package.json ./client/
COPY server/package.json ./server/

# HUSKY=0: the root prepare script runs husky, which has no .git in the image.
ENV HUSKY=0
RUN npm ci

WORKDIR /app/client

# Copy client source
COPY client/ ./

# Build client for production (Vite outputs to ../server/public)
ARG VITE_BRANDING_PROFILE=secassured
ENV VITE_BRANDING_PROFILE=$VITE_BRANDING_PROFILE
RUN npm run build

# Stage 2: Build server
FROM node:22-bookworm-slim AS server-builder

WORKDIR /app

COPY package.json package-lock.json ./
COPY client/package.json ./client/
COPY server/package.json ./server/

ENV HUSKY=0
RUN npm ci

WORKDIR /app/server

# Copy server source
COPY server/src ./src
COPY server/tsconfig.json ./

# Compile TypeScript
RUN npm run build

# Trim dev dependencies before copying the runtime image (runs at the
# workspace root — --workspace resolves against the root manifest).
RUN cd /app && npm prune --omit=dev --workspace=server && npm cache clean --force

# Pre-create the data dir here: the distroless runtime has no shell, so it
# cannot mkdir. A named volume mounted at this path inherits the directory's
# ownership from the image, which is what lets the seed marker be written.
RUN mkdir -p /app/server/data

# Stage 3: Production image
FROM gcr.io/distroless/nodejs22-debian13:nonroot AS production

WORKDIR /app/server

# Copy server — hoisted workspace deps live at /app/node_modules (Node walks
# up from /app/server to find them)
COPY --from=server-builder --chown=nonroot:nonroot /app/node_modules /app/node_modules
COPY --from=server-builder --chown=nonroot:nonroot /app/server/dist ./dist
COPY --from=server-builder --chown=nonroot:nonroot /app/server/package.json ./

# Copy client build (Vite outputs to ../server/public)
COPY --from=client-builder --chown=nonroot:nonroot /app/server/public ./public

# Writable data dir for the seed marker (see the builder stage above).
COPY --from=server-builder --chown=nonroot:nonroot /app/server/data ./data

# Switch to non-root user
USER nonroot

# Environment defaults for unified mode
ENV SERVE_STATIC=true
ENV NODE_ENV=production
ENV PORT=3000
# Seeding is opt-in and refuses known-default ADMIN_PASSWORDs.
ENV SEED_ON_STARTUP=false

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD ["/nodejs/bin/node", "-e", "fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]

CMD ["dist/bootstrap.js"]
