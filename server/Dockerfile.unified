# Unified Dockerfile - Serves both API and client from single container
# Use this for simplified deployments (demos, staging, single-server hosting)

# Stage 1: Build client
FROM node:20-slim AS client-builder

WORKDIR /app/client

# Copy client package files
COPY client/package.json client/package-lock.json ./

# Install client dependencies
RUN npm install --legacy-peer-deps

# Copy client source
COPY client/ ./

# Build client for production
RUN npm run build

# Stage 2: Build server
FROM node:20-slim AS server-builder

WORKDIR /app/server

# Copy server package files
COPY server/package.json server/package-lock.json ./

# Install server dependencies
RUN npm install --legacy-peer-deps

# Copy server source
COPY server/src ./src
COPY server/tsconfig.json ./

# Compile TypeScript
RUN npm run build

# Stage 3: Production image
FROM node:20-slim AS production

WORKDIR /app

# Install curl for healthcheck (required in slim image)
# Create non-root user for security (Debian-based image)
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 1001 nodejs \
    && useradd --system --uid 1001 --gid nodejs intact

# Copy server
COPY --from=server-builder /app/server/node_modules ./server/node_modules
COPY --from=server-builder /app/server/dist ./server/dist
COPY --from=server-builder /app/server/package.json ./server/

# Copy client build (Vite outputs to ../server/public)
COPY --from=client-builder /app/server/public ./server/public

# Copy entrypoint script and set permissions
COPY --chmod=755 server/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

# Create data directory for persistent state (seed marker)
RUN mkdir -p /app/server/data

# Set ownership (excluding entrypoint which stays root-owned but executable)
RUN chown -R intact:nodejs /app

# Switch to non-root user
USER intact

WORKDIR /app/server

# Environment defaults for unified mode
ENV SERVE_STATIC=true
ENV NODE_ENV=production
ENV PORT=3000
ENV SEED_ON_STARTUP=true

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD curl -f http://localhost:3000/api/health || exit 1

# Use entrypoint for startup logic (seeds database on first run)
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["node", "dist/app.js"]
