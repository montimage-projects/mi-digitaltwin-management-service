# Unified Dockerfile - Serves both API and client from single container
# Use this for simplified deployments (demos, staging, single-server hosting)

# Stage 1: Build client
FROM oven/bun:1 AS client-builder

WORKDIR /app/client

# Copy client package files
COPY client/package.json client/bun.lockb* ./

# Install client dependencies
RUN bun install --frozen-lockfile

# Copy client source
COPY client/ ./

# Build client for production
RUN bun run build

# Stage 2: Build server
FROM oven/bun:1 AS server-builder

WORKDIR /app/server

# Copy server package files
COPY server/package.json server/bun.lockb* ./

# Install server dependencies
RUN bun install --frozen-lockfile

# Copy server source
COPY server/src ./src
COPY server/tsconfig.json ./

# Stage 3: Production image
FROM oven/bun:1-slim AS production

WORKDIR /app

# Install curl for healthcheck (required in slim image)
# Create non-root user for security (Debian-based image)
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 1001 nodejs \
    && useradd --system --uid 1001 --gid nodejs intact

# Copy server
COPY --from=server-builder /app/server/node_modules ./server/node_modules
COPY --from=server-builder /app/server/src ./server/src
COPY --from=server-builder /app/server/package.json ./server/

# Copy client build
COPY --from=client-builder /app/client/dist ./client/dist

# Set ownership
RUN chown -R intact:nodejs /app

# Switch to non-root user
USER intact

WORKDIR /app/server

# Environment defaults for unified mode
ENV SERVE_STATIC=true
ENV NODE_ENV=production
ENV PORT=3000

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:3000/api/health || exit 1

# Start the server
CMD ["bun", "src/app.ts"]
