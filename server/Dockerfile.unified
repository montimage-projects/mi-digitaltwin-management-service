# Unified Dockerfile - Serves both API and client from single container
# Use this for simplified deployments (demos, staging, single-server hosting)

# Stage 1: Build client
FROM node:22-bookworm-slim AS client-builder

WORKDIR /app/client

# Copy client package files
COPY client/package.json client/package-lock.json ./

# Install client dependencies
RUN npm ci

# Copy client source
COPY client/ ./

# Build client for production
RUN npm run build

# Stage 2: Build server
FROM node:22-bookworm-slim AS server-builder

WORKDIR /app/server

# Copy server package files
COPY server/package.json server/package-lock.json ./

# Install server dependencies
RUN npm ci

# Copy server source
COPY server/src ./src
COPY server/tsconfig.json ./

# Compile TypeScript
RUN npm run build

# Trim dev dependencies before copying the runtime image.
RUN npm prune --omit=dev && npm cache clean --force

# Pre-create the data dir here: the distroless runtime has no shell, so it
# cannot mkdir. A named volume mounted at this path inherits the directory's
# ownership from the image, which is what lets the seed marker be written.
RUN mkdir -p /app/server/data

# Stage 3: Production image
FROM gcr.io/distroless/nodejs22-debian13:nonroot AS production

WORKDIR /app/server

# Copy server
COPY --from=server-builder --chown=nonroot:nonroot /app/server/node_modules ./node_modules
COPY --from=server-builder --chown=nonroot:nonroot /app/server/dist ./dist
COPY --from=server-builder --chown=nonroot:nonroot /app/server/package.json ./

# Copy client build (Vite outputs to ../server/public)
COPY --from=client-builder --chown=nonroot:nonroot /app/server/public ./public

# Writable data dir for the seed marker (see the builder stage above).
COPY --from=server-builder --chown=nonroot:nonroot /app/server/data ./data

# Switch to non-root user
USER nonroot

# Environment defaults for unified mode
ENV SERVE_STATIC=true
ENV NODE_ENV=production
ENV PORT=3000
ENV SEED_ON_STARTUP=true

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD ["/nodejs/bin/node", "-e", "fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]

CMD ["dist/bootstrap.js"]
